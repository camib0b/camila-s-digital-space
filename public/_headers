# Vite emits ffmpeg-core as a hashed file under /assets. Workers static
# assets must serve it as application/wasm. The site worker sets the same
# header when it handles *.wasm first.
/*.wasm
  Content-Type: application/wasm

/assets/*.wasm
  Content-Type: application/wasm

/fonts/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000
