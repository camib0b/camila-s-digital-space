{
	"name": "camilaescudero",
	"main": "site-worker/index.ts",
	"compatibility_date": "2026-01-11",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		// API routes and wasm files run the worker first. Every other path stays
		// on the asset pipeline, so SPA fallback keeps working.
		// The worker sets Content-Type: application/wasm. public/_headers sets
		// the same type when the asset pipeline serves the file instead.
		"run_worker_first": ["/api/*", "/assets/*.wasm"]
	},
	"d1_databases": [
		{
			"binding": "AVA_INTEREST",
			"database_name": "ava-interest",
			"database_id": "f6286d54-7d63-44da-847f-92b3feff7cdf"
		}
	],
	"send_email": [
		{
			"name": "AVA_ALERT"
		},
		{
			// 404 feedback. Must be a verified Email Routing destination, and must
			// match CONTACT_EMAIL in src/content/contact.ts.
			"name": "FEEDBACK_404",
			"destination_address": "camilaescuderob@gmail.com"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "CONCAT_EVENTS",
			"dataset": "concat_events"
		},
		{
			"binding": "XML_EVENTS",
			"dataset": "xml_events"
		}
	],
	"vars": {
		"AVA_ALERT_TO": "camilaescudero@uc.cl"
	},
	"observability": {
	  "enabled": false,
	  "head_sampling_rate": 1,
	  "logs": {
		"enabled": true,
		"head_sampling_rate": 1,
		"persist": true,
		"invocation_logs": true
	  },
	  "traces": {
		"enabled": false,
		"persist": true,
		"head_sampling_rate": 1
	  }
	}
  }
